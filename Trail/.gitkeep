<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>TRAIL.IO — Claim It. Risk It. Own It.</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --cyan:#00e5ff; --cyan2:#3ff0ff; --pink:#ff2fd6; --yellow:#ffd400; --purple:#9d3bff;
    --bg:#04070f; --panel:rgba(10,18,34,0.72); --panelBorder:rgba(0,229,255,0.35);
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent; user-select:none;}
  html,body{margin:0;padding:0;width:100%;height:100%;background:var(--bg);overflow:hidden;
    font-family:'Rajdhani',sans-serif; color:#dff6ff; touch-action:none;}
  #app{position:fixed;inset:0;width:100%;height:100%;}
  canvas#three-canvas{position:absolute;inset:0;width:100%;height:100%;display:block;}

  .screen{position:absolute;inset:0;display:none;flex-direction:column;align-items:center;justify-content:center;
    z-index:20; background:radial-gradient(ellipse at 50% 20%, rgba(0,60,90,0.35), rgba(2,4,10,0.92) 70%);
    backdrop-filter:blur(2px);}
  .screen.active{display:flex;}
  .glow-title{font-family:'Orbitron',sans-serif;font-weight:900;letter-spacing:4px;
    font-size:clamp(38px,11vw,72px); color:#fff;
    text-shadow:0 0 8px var(--cyan), 0 0 24px var(--cyan), 0 0 60px rgba(0,229,255,0.6);
    margin:0; text-align:center;}
  .subtitle{font-family:'Orbitron',sans-serif; font-size:clamp(11px,3vw,16px); letter-spacing:6px;
    color:var(--cyan2); margin-top:6px; text-shadow:0 0 10px rgba(63,240,255,0.8); text-align:center;}
  .menu-art{display:flex;gap:10px;align-items:center;justify-content:center;margin:18px 0;}
  .menu-art img{height:64px; filter:drop-shadow(0 0 12px rgba(0,229,255,0.55)); animation:floaty 3.4s ease-in-out infinite;}
  .menu-art img:nth-child(2){animation-delay:.4s;}
  .menu-art img:nth-child(3){animation-delay:.8s;}
  @keyframes floaty{0%,100%{transform:translateY(0px)}50%{transform:translateY(-10px)}}

  .btn-col{display:flex;flex-direction:column;gap:14px;margin-top:26px;width:min(78vw,320px);}
  .btn{position:relative; font-family:'Orbitron',sans-serif; font-weight:700; letter-spacing:2px;
    font-size:16px; color:#eafcff; background:linear-gradient(180deg, rgba(0,229,255,0.22), rgba(0,120,180,0.12));
    border:1.5px solid var(--panelBorder); border-radius:14px; padding:16px 20px; text-align:center;
    box-shadow:0 0 18px rgba(0,229,255,0.25), inset 0 0 12px rgba(0,229,255,0.12);
    cursor:pointer; transition:transform .12s ease, box-shadow .12s ease;}
  .btn:active{transform:scale(0.96); box-shadow:0 0 26px rgba(0,229,255,0.55), inset 0 0 16px rgba(0,229,255,0.25);}
  .btn.primary{background:linear-gradient(180deg, rgba(0,229,255,0.55), rgba(0,120,200,0.35)); color:#031018;
    box-shadow:0 0 26px rgba(0,229,255,0.65), inset 0 0 14px rgba(255,255,255,0.35);}
  .btn.pink{border-color:rgba(255,47,214,0.5); box-shadow:0 0 18px rgba(255,47,214,0.25);}
  .btn.ghost{background:rgba(255,255,255,0.03);}

  .top-nav{position:absolute; top:18px; left:18px; display:flex; gap:10px; z-index:5;}
  .icon-btn{width:44px;height:44px;border-radius:12px;background:var(--panel);border:1px solid var(--panelBorder);
    display:flex;align-items:center;justify-content:center;font-size:20px;color:#dff6ff;cursor:pointer;}

  /* ===== HUD ===== */
  #hud{position:absolute;inset:0;z-index:15;pointer-events:none;display:none;}
  #hud.active{display:block;}
  .hud-panel{position:absolute; pointer-events:auto; background:var(--panel); border:1px solid var(--panelBorder);
    border-radius:14px; box-shadow:0 0 16px rgba(0,229,255,0.18); backdrop-filter:blur(4px);}
  #scorePanel{top:14px; left:14px; padding:8px 16px;}
  #scoreLabel{font-family:'Orbitron',sans-serif;font-size:10px;letter-spacing:2px;color:#7fdcff;opacity:.8;}
  #scoreValue{font-family:'Orbitron',sans-serif;font-size:22px;font-weight:700;color:#fff;text-shadow:0 0 10px var(--cyan);}
  #territoryPanel{top:14px; left:50%; transform:translateX(-50%); padding:8px 22px; text-align:center;}
  #territoryLabel{font-family:'Orbitron',sans-serif;font-size:10px;letter-spacing:3px;color:#7fdcff;opacity:.8;}
  #territoryValue{font-family:'Orbitron',sans-serif;font-size:22px;font-weight:700;color:#fff;text-shadow:0 0 10px var(--cyan);}
  #pauseBtn{top:14px; right:14px; width:46px;height:46px; display:flex;align-items:center;justify-content:center;font-size:20px;cursor:pointer;}
  #comboBadge{top:70px; left:50%; transform:translateX(-50%); padding:4px 14px; opacity:0; transition:opacity .2s, transform .2s;
    font-family:'Orbitron',sans-serif; font-weight:700; color:#ffe37a; text-shadow:0 0 10px #ffb200; border-color:rgba(255,196,0,0.5);}
  #comboBadge.show{opacity:1;}
  #powerupBar{top:70px; right:14px; display:flex; flex-direction:column; gap:6px; align-items:flex-end;}
  .pw-chip{display:flex; align-items:center; gap:6px; padding:5px 10px; font-size:12px; font-weight:600;
    color:#fff; opacity:0; transform:translateX(10px); transition:all .2s;}
  .pw-chip.show{opacity:1; transform:translateX(0);}
  .pw-chip img{width:20px;height:20px;}

  #joyZone{position:absolute; left:0; bottom:0; width:46%; height:46%; pointer-events:auto;}
  #joyBase{position:absolute; width:118px;height:118px;border-radius:50%; border:2px solid rgba(0,229,255,0.45);
    background:radial-gradient(circle at 40% 35%, rgba(0,229,255,0.14), rgba(4,10,20,0.55));
    box-shadow:0 0 20px rgba(0,229,255,0.25), inset 0 0 14px rgba(0,229,255,0.2); display:none;}
  #joyStick{position:absolute; width:52px;height:52px;border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #bdfaff, #00c3e0 60%, #007b93); box-shadow:0 0 16px var(--cyan);}

  #actionBar{position:absolute; right:16px; bottom:26px; display:flex; flex-direction:column; gap:12px; pointer-events:auto;}
  .action-btn{width:58px;height:58px;border-radius:50%; background:var(--panel); border:1.5px solid var(--panelBorder);
    display:flex;align-items:center;justify-content:center; box-shadow:0 0 14px rgba(0,229,255,0.2); position:relative;}
  .action-btn img{width:34px;height:34px;}
  .action-btn .cd{position:absolute;inset:0;border-radius:50%;background:conic-gradient(rgba(0,0,0,0.65) var(--p,0%), transparent 0);}
  .action-btn .count{position:absolute;bottom:-16px;font-size:10px;color:#9fe8ff;font-family:'Orbitron';}

  #floatLayer{position:absolute;inset:0;z-index:16;pointer-events:none;overflow:hidden;}
  .floatText{position:absolute; font-family:'Orbitron',sans-serif; font-weight:700; white-space:nowrap;
    text-shadow:0 0 8px currentColor; animation:floatUp 1.15s ease-out forwards;}
  @keyframes floatUp{0%{opacity:0; transform:translate(-50%,0) scale(0.7);}15%{opacity:1; transform:translate(-50%,-8px) scale(1.08);}
    100%{opacity:0; transform:translate(-50%,-70px) scale(1);}}

  #dangerFlash{position:absolute; inset:0; z-index:14; pointer-events:none; background:radial-gradient(ellipse at center, transparent 55%, rgba(255,20,20,0.35) 100%);
    opacity:0; transition:opacity .15s;}
  #dangerFlash.show{opacity:1;}

  /* ===== Result screens ===== */
  .stat-card{width:min(84vw,340px); background:var(--panel); border:1px solid var(--panelBorder); border-radius:16px;
    padding:20px 24px; margin-top:18px; box-shadow:0 0 24px rgba(0,229,255,0.2);}
  .stat-row{display:flex; justify-content:space-between; padding:7px 0; border-bottom:1px dashed rgba(255,255,255,0.08);
    font-size:15px; letter-spacing:1px;}
  .stat-row:last-child{border-bottom:none;}
  .stat-row b{color:#fff; font-family:'Orbitron',sans-serif; font-size:15px;}
  .result-sub{font-family:'Orbitron',sans-serif; letter-spacing:2px; font-size:14px; color:#ff5d7a; margin-top:8px; text-shadow:0 0 10px #ff2d4d;}
  .result-sub.win{color:#7dffb0; text-shadow:0 0 10px #17ffb0;}

  /* ===== Leaderboard ===== */
  .lb-tabs{display:flex; gap:8px; margin-bottom:14px;}
  .lb-tab{padding:8px 20px; border-radius:20px; border:1px solid var(--panelBorder); font-family:'Orbitron'; font-size:12px; letter-spacing:2px; cursor:pointer; background:rgba(255,255,255,0.02);}
  .lb-tab.active{background:rgba(0,229,255,0.28); box-shadow:0 0 14px rgba(0,229,255,0.4);}
  .lb-list{width:min(88vw,380px); display:flex; flex-direction:column; gap:8px; max-height:44vh; overflow-y:auto;}
  .lb-row{display:flex; align-items:center; gap:10px; background:var(--panel); border:1px solid rgba(255,255,255,0.08); border-radius:12px; padding:8px 12px;}
  .lb-rank{width:26px; text-align:center; font-family:'Orbitron'; font-weight:700; color:#9fe8ff;}
  .lb-rank.gold{color:#ffd400; text-shadow:0 0 8px #ffb200;}
  .lb-name{flex:1; font-weight:600; letter-spacing:1px;}
  .lb-score{font-family:'Orbitron'; color:#fff; font-size:13px;}
  .lb-avatar{width:30px;height:30px;border-radius:50%;object-fit:cover;background:#04121a;}

  /* Arenas screen */
  .arena-grid{display:flex; gap:14px; flex-wrap:wrap; justify-content:center; max-width:90vw;}
  .arena-card{width:120px; text-align:center; background:var(--panel); border:1px solid var(--panelBorder); border-radius:14px; padding:10px; opacity:0.55;}
  .arena-card.unlocked{opacity:1; box-shadow:0 0 16px rgba(0,229,255,0.3);}
  .arena-card img{width:100%; border-radius:8px;}
  .arena-card .name{font-family:'Orbitron'; font-size:10px; margin-top:6px; letter-spacing:1px;}

  #loadingScreen{position:absolute;inset:0;z-index:50;display:flex;flex-direction:column;align-items:center;justify-content:center;background:var(--bg);}
  .loadbar{width:220px;height:6px;border-radius:4px;background:rgba(255,255,255,0.08);overflow:hidden;margin-top:18px;}
  .loadbar i{display:block;height:100%;width:0%;background:linear-gradient(90deg,var(--cyan),#7dffe0);box-shadow:0 0 10px var(--cyan);transition:width .2s;}

  #countdownWrap{position:absolute;inset:0;z-index:18;display:none;align-items:center;justify-content:center;pointer-events:none;}
  #countdownWrap.show{display:flex;}
  #countdownNum{font-family:'Orbitron';font-weight:900;font-size:110px;color:#fff;text-shadow:0 0 30px var(--cyan);}

  .small-muted{font-size:11px;color:#7fb8cc;letter-spacing:1px;margin-top:10px;text-align:center;max-width:280px;}
</style>
</head>
<body>
<div id="app">
  <canvas id="three-canvas"></canvas>

  <div id="loadingScreen">
    <div class="glow-title" style="font-size:34px;">TRAIL.IO</div>
    <div class="subtitle">CLAIM IT. RISK IT. OWN IT.</div>
    <div class="loadbar"><i id="loadbarFill"></i></div>
  </div>

  <!-- MAIN MENU -->
  <div class="screen" id="screen-menu">
    <h1 class="glow-title">TRAIL.IO</h1>
    <div class="subtitle">CLAIM IT. RISK IT. OWN IT.</div>
    <div class="menu-art">
      <img data-asset="player" alt=""/>
      <img data-asset="enemy_pink" alt=""/>
      <img data-asset="enemy_yellow" alt=""/>
      <img data-asset="enemy_purple" alt=""/>
    </div>
    <div class="btn-col">
      <div class="btn primary" id="btnPlay">▶ PLAY</div>
      <div class="btn" id="btnArenas">🗺 ARENAS</div>
      <div class="btn" id="btnLeaderboard">🏆 LEADERBOARD</div>
      <div class="btn" id="btnSettings">⚙ SETTINGS</div>
    </div>
    <div class="small-muted">Best Score: <b id="menuBestScore">0</b></div>
  </div>

  <!-- ARENAS -->
  <div class="screen" id="screen-arenas">
    <h2 class="glow-title" style="font-size:32px;">ARENAS</h2>
    <div class="subtitle" style="margin-bottom:18px;">SELECT YOUR BATTLEGROUND</div>
    <div class="arena-grid" id="arenaGrid"></div>
    <div class="btn-col" style="margin-top:24px;"><div class="btn ghost" data-back="screen-menu">← BACK</div></div>
  </div>

  <!-- LEADERBOARD -->
  <div class="screen" id="screen-leaderboard">
    <img data-asset="leaderboard" style="height:96px;margin-bottom:-6px;filter:drop-shadow(0 0 16px rgba(255,196,0,0.45));"/>
    <h2 class="glow-title" style="font-size:32px;">LEADERBOARD</h2>
    <div class="lb-tabs">
      <div class="lb-tab active" data-tab="global">GLOBAL</div>
      <div class="lb-tab" data-tab="friends">FRIENDS</div>
    </div>
    <div class="lb-list" id="lbList"></div>
    <div class="btn-col" style="margin-top:20px;"><div class="btn ghost" data-back="screen-menu">← BACK</div></div>
  </div>

  <!-- SETTINGS -->
  <div class="screen" id="screen-settings">
    <h2 class="glow-title" style="font-size:32px;">SETTINGS</h2>
    <div class="btn-col">
      <div class="btn" id="toggleSound">🔊 SOUND: ON</div>
      <div class="btn" id="toggleMusic">🎵 MUSIC: ON</div>
      <div class="btn ghost" data-back="screen-menu">← BACK</div>
    </div>
  </div>

  <!-- GAME OVER -->
  <div class="screen" id="screen-gameover">
    <img data-asset="explosion" style="height:78px;margin-bottom:-8px;"/>
    <h2 class="glow-title" style="font-size:38px; color:#ff5d7a; text-shadow:0 0 8px #ff2d4d,0 0 24px #ff2d4d;">GAME OVER</h2>
    <div class="result-sub" id="deathReason">YOU GOT CUT!</div>
    <div class="stat-card">
      <div class="stat-row"><span>SCORE</span><b id="goScore">0</b></div>
      <div class="stat-row"><span>TERRITORY</span><b id="goTerritory">0%</b></div>
      <div class="stat-row"><span>BEST SCORE</span><b id="goBest">0</b></div>
      <div class="stat-row"><span>RANK</span><b id="goRank">#4</b></div>
      <div class="stat-row"><span>LARGEST CAPTURE</span><b id="goLargest">0%</b></div>
    </div>
    <div class="btn-col">
      <div class="btn primary" id="btnRestartGO"><img data-asset="restart" style="height:20px;vertical-align:-5px;margin-right:6px;"/>RESTART</div>
      <div class="btn ghost" data-back="screen-menu">MAIN MENU</div>
    </div>
  </div>

  <!-- VICTORY -->
  <div class="screen" id="screen-victory">
    <h2 class="glow-title" style="font-size:36px;">🏆 VICTORY!</h2>
    <div class="result-sub win" id="victorySub">DOMINANT TERRITORY HOLDER</div>
    <div class="stat-card">
      <div class="stat-row"><span>TERRITORY</span><b id="vTerritory">0%</b></div>
      <div class="stat-row"><span>SCORE</span><b id="vScore">0</b></div>
      <div class="stat-row"><span>BEST CAPTURE</span><b id="vBestCapture">0%</b></div>
      <div class="stat-row"><span>ENEMIES DEFEATED</span><b id="vEnemies">0</b></div>
    </div>
    <div class="btn-col">
      <div class="btn primary" id="btnRestartV">PLAY AGAIN</div>
      <div class="btn ghost" data-back="screen-menu">MAIN MENU</div>
    </div>
  </div>

  <!-- PAUSE -->
  <div class="screen" id="screen-pause">
    <h2 class="glow-title" style="font-size:30px;">PAUSED</h2>
    <div class="btn-col">
      <div class="btn primary" id="btnResume">▶ RESUME</div>
      <div class="btn" id="btnPauseRestart">↻ RESTART</div>
      <div class="btn ghost" id="btnPauseMenu">MAIN MENU</div>
    </div>
  </div>

  <!-- HUD -->
  <div id="hud">
    <div class="hud-panel" id="scorePanel"><div id="scoreLabel">SCORE</div><div id="scoreValue">0</div></div>
    <div class="hud-panel" id="territoryPanel"><div id="territoryLabel">TERRITORY</div><div id="territoryValue">10%</div></div>
    <div class="hud-panel icon-btn" id="pauseBtn">⏸</div>
    <div class="hud-panel" id="comboBadge">COMBO x2</div>
    <div id="powerupBar">
      <div class="pw-chip hud-panel" id="chip_power"><img data-asset="pw_power"/><span>SURGE</span></div>
      <div class="pw-chip hud-panel" id="chip_speed"><img data-asset="pw_speed"/><span>SPEED</span></div>
      <div class="pw-chip hud-panel" id="chip_shield"><img data-asset="pw_shield"/><span>SHIELD</span></div>
    </div>
    <div id="joyZone"><div id="joyBase"><div id="joyStick"></div></div></div>
    <div id="actionBar">
      <div class="action-btn" id="btnBomb"><img data-asset="pw_bomb"/><div class="cd" id="bombCd" style="--p:0%"></div><div class="count" id="bombCount">0</div></div>
    </div>
  </div>

  <div id="floatLayer"></div>
  <div id="dangerFlash"></div>
  <div id="countdownWrap"><div id="countdownNum">3</div></div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
const ASSETS = {"pw_speed": "data:image/webp;base64,", "explosion": "data:image/webp;base64,", "arenas": "data:image/webp;base64,", "enemy_purple": "data:image/webp;base64,", "trail": "data:image/webp;base64,", "enemies": "data:image/webp;base64,
